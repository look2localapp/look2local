generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ─── CUSTOMER PROFILE ─────────────────────────────────────
// Linked to Clerk userId — customers only (not shopkeepers)
model CustomerProfile {
  id           String   @id @default(cuid())
  clerkId      String   @unique   // Clerk userId
  name         String
  email        String   @unique
  phone        String?
  profilePhoto String?  // Cloudinary URL
  address      String?
  city         String?
  pincode      String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coupons      Coupon[]
  wishlist     Wishlist[]
  priceAlerts  PriceAlert[]
  recentlyViewed RecentlyViewed[]
  lockedOffers LockedOffer[]
  reviews      Review[]

  // Referral System
  referralCode    String?         @unique
  referralBalance Float           @default(0)
  referredById    String?
  referredBy      CustomerProfile? @relation("Referrals", fields: [referredById], references: [id])
  referrals       CustomerProfile[] @relation("Referrals")
}

// ─── SHOPKEEPER PROFILE ────────────────────────────────────
model Shopkeeper {
  id           String   @id   // Clerk userId used directly as PK
  email        String   @unique
  passwordHash String
  shop         Shop?
  createdAt    DateTime @default(now())
}

// ─── SHOP ─────────────────────────────────────────────────
model Shop {
  id              String   @id @default(cuid())
  shop_name       String
  owner_name      String
  phone           String
  whatsapp        String?
  address         String
  landmark        String?
  google_map_link String
  shop_image      String   // Cloudinary URL
  banner_image    String   // Cloudinary URL
  gst_number      String?
  gst_verified    Boolean  @default(false)
  business_name   String?
  gst_status      String?
  legal_name      String?
  trade_name      String?
  business_type   String?
  aadhaar_verified Boolean? @default(false)
  principal_address String?
  category        String
  opening_hours   String   @default("10:00 AM - 9:00 PM")
  verified        Boolean  @default(false)
  featured        Boolean  @default(false)
  delivery_available Boolean @default(false)
  shopkeeperId    String   @unique
  shopkeeper      Shopkeeper @relation(fields: [shopkeeperId], references: [id])
  products        Product[]
  reels           Reel[]
  subscription    Subscription?
  coupons         Coupon[]
  reviews         Review[]
  createdAt       DateTime @default(now())
}

// ─── PRODUCT ──────────────────────────────────────────────
model Product {
  id               String      @id @default(cuid())
  title            String
  description      String
  price            Float
  discount         Float       @default(0)
  images           String[]    // Cloudinary URLs
  inStock          Boolean     @default(true)
  stock            Int         @default(0)
  brand            String?
  category         String?
  barcode          String?     @unique
  masterProductId  String?
  masterProduct    MasterProduct? @relation(fields: [masterProductId], references: [id])
  shopId           String
  shop             Shop        @relation(fields: [shopId], references: [id])
  cardOffers       CardOffer[]
  lockedOffers     LockedOffer[]
  coupons          Coupon[]
  wishlist         Wishlist[]
  priceAlerts      PriceAlert[]
  recentlyViewed   RecentlyViewed[]
  reviews          Review[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ─── MASTER PRODUCT CATALOG ────────────────────────────────
model MasterProduct {
  id           String    @id @default(cuid())
  name         String
  brand        String
  category     String    // Mobiles | Laptops | TVs | Cameras | SmartWatches | Trimmers | HomeAppliances | Gaming | Accessories
  image        String?   // Default product image URL
  description  String?
  specifications Json?   // { storage: [...], colors: [...], ram: [...], etc. }
  barcode      String?   @unique
  createdAt    DateTime  @default(now())

  products     Product[]
}

// ─── COUPON ───────────────────────────────────────────────
model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique  // e.g. L2L-AB123
  qrData          String            // QR code data string
  couponCost      Float             // Amount customer paid (e.g. ₹50)
  discountAmount  Float             // Amount customer saves (e.g. ₹300)
  status          String   @default("ACTIVE") // ACTIVE | REDEEMED | EXPIRED
  expiresAt       DateTime
  redeemedAt      DateTime?
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id])
  shopId          String?
  shop            Shop?    @relation(fields: [shopId], references: [id])
  paymentId       String?          // Razorpay paymentId
  razorpayOrderId String?
  review          Review?
  createdAt       DateTime @default(now())
}

// ─── SUBSCRIPTION ──────────────────────────────────────────
model Subscription {
  id          String   @id @default(cuid())
  plan        String   @default("FREE_TRIAL") // FREE_TRIAL | STANDARD | PREMIUM
  status      String   @default("ACTIVE")     // ACTIVE | EXPIRED | CANCELLED
  startDate   DateTime @default(now())
  endDate     DateTime
  shopId      String   @unique
  shop        Shop     @relation(fields: [shopId], references: [id])
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── PAYMENT ──────────────────────────────────────────────
model Payment {
  id               String   @id @default(cuid())
  type             String   // COUPON | SUBSCRIPTION
  amount           Float
  currency         String   @default("INR")
  status           String   @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  razorpayOrderId  String?  @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  description      String?
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt        DateTime @default(now())
}

// ─── CARD OFFER (BANK OFFERS) ──────────────────────────────
model CardOffer {
  id         String  @id @default(cuid())
  bank_name  String
  card_type  String  // Credit | Debit | EMI
  offer_text String
  min_amount Float   @default(0)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
}

// ─── LOCKED OFFER (USP) ───────────────────────────────────
model LockedOffer {
  id                String   @id @default(cuid())
  lock_code         String   @unique
  customer_name     String
  customer_phone    String
  customer_address  String
  customer_map_link String?
  status            String   @default("LOCKED") // LOCKED | REDEEMED | EXPIRED
  expiresAt         DateTime
  lockedAt          DateTime @default(now())
  customerId        String?
  customer          CustomerProfile? @relation(fields: [customerId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
}

// ─── WISHLIST ────────────────────────────────────────────
model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ─── PRICE ALERT ─────────────────────────────────────────
model PriceAlert {
  id           String   @id @default(cuid())
  customerId   String
  customer     CustomerProfile @relation(fields: [customerId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  targetPrice  Float
  triggered    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([customerId, productId])
}

// ─── RECENTLY VIEWED ──────────────────────────────────────
model RecentlyViewed {
  id         String   @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  viewedAt   DateTime @default(now())

  @@unique([customerId, productId])
}

// ─── REELS ────────────────────────────────────────────────
model Reel {
  id         String   @id @default(cuid())
  video_url  String   // Cloudinary URL
  thumbnail  String?  // Cloudinary URL
  caption    String
  views      Int      @default(0)
  likes      Int      @default(0)
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  productId  String?
  createdAt  DateTime @default(now())
}

// ─── ORDERS ───────────────────────────────────────────────
model Order {
  id        String   @id @default(cuid())
  status    String   @default("PENDING")
  type      String   @default("STORE_VISIT")
  productId String
  userId    String
  createdAt DateTime @default(now())
}

// ─── REVIEWS ──────────────────────────────────────────────
model Review {
  id               String   @id @default(cuid())
  rating           Float    // e.g. 4.8
  comment          String?
  customerId       String
  customer         CustomerProfile @relation(fields: [customerId], references: [id])
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id])
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  couponId         String?  @unique
  coupon           Coupon?  @relation(fields: [couponId], references: [id])
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
}
